# Rename this file to .env before running

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/civic_db"

# JWT secret - change this to any random long string
JWT_SECRET="change_this_to_a_long_random_secret_key_12345"
JWT_EXPIRES_IN="7d"

# Server port
PORT=5000
